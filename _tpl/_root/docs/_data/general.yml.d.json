{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Website Configuration",
  "description": "JSON schema for website configuration. Use data from context to fill in the values.",
  "type": "object",
  "properties": {
    "pagebuilder": {
      "type": "string",
      "description": "Pagebuilder-URL"
    },
    "site_base_url": {
      "type": "string",
      "description": "Canonical Base-URL in 10_blanc"
    },
    "subscription_id": {
      "type": "string",
      "description": "Formmailer-Konfiguration in 10_blanc"
    },
    "title": {
      "type": "string",
      "description": "Globaler Seitentitel in 10_blanc"
    },
    "name": {
      "type": "string",
      "description": "Globaler Praxisname"
    },
    "name2": {
      "type": "string",
      "description": "Globale Praxisbezeichnung",
      "nullable": true
    },
    "desc": {
      "type": "string",
      "description": "Globale Website-Beschreibung"
    },
    "fachrichtung": {
      "type": "string",
      "description": "Fachrichtung"
    },
    "logoalt": {
      "type": "string",
      "description": "Logo-Alternativtext in der Navbar"
    },
    "datenschutzbeauftragter": {
      "type": "string",
      "description": "Globale Datenschutzangabe"
    },
    "bildnachweise": {
      "type": "string",
      "description": "Bildnachweise im Impressum"
    },
    "domain": {
      "type": "string",
      "description": "Globale Domain-Angabe",
      "nullable": true
    },
    "tools": {
      "type": "object",
      "description": "Globale Tool- und Integrationsschalter",
      "properties": {
        "googlemaps": {
          "type": "boolean",
          "description": "Google Maps enabled"
        },
        "jameda": {
          "type": "boolean",
          "description": "Jameda enabled: Default is false"
        },
        "recaptcha": {
          "type": "boolean",
          "description": "reCAPTCHA enabled: Default is false"
        }
      },
      "required": [
        "googlemaps",
        "jameda",
        "recaptcha"
      ]
    },
    "standorte": {
      "type": "object",
      "description": "Standortkonfiguration, default wird von Include-Komponenten und Kontaktseiten verwendet.",
      "properties": {
        "default": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Standortname; Adresse, Impressum, Navbar, VCard"
            },
            "name2": {
              "type": [
                "string",
                "null"
              ],
              "description": "Standortzusatz; Adresse und Impressum",
              "nullable": true
            },
            "street": {
              "type": "string",
              "description": "Straße; Adresse, Impressum, VCard"
            },
            "zip": {
              "type": "string",
              "description": "Postleitzahl; Adresse, Impressum, VCard"
            },
            "city": {
              "type": "string",
              "description": "Ort; Adresse, Impressum, VCard"
            },
            "termin_url": {
              "type": "string",
              "description": "Termin-URL des Standorts"
            },
            "map_url": {
              "type": "string",
              "description": "Google-Maps-Embed; Consent-Blocker in Kontakt/Anfahrt und 10_blanc"
            },
            "map_link": {
              "type": "string",
              "description": "Kartenlink für Anfahrtslinks"
            },
            "phone1_text": {
              "type": "string",
              "description": "Telefonanzeige; Adresse, Impressum und VCard"
            },
            "phone1": {
              "type": "string",
              "description": "Telefonziel; Adresse, Impressum und VCard"
            },
            "fax1_text": {
              "type": [
                "string",
                "null"
              ],
              "description": "Fax; Adresse und Impressum"
            },
            "email": {
              "type": [
                "string",
                "null"
              ],
              "description": "E-Mail; Adresse, Impressum und VCard"
            }
          },
          "required": [
            "name",
            "street",
            "zip",
            "city"
          ]
        }
      },
      "required": [
        "default"
      ],
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Standortname; Adresse, Impressum, Navbar, VCard"
          },
          "name2": {
            "type": [
              "string",
              "null"
            ],
            "description": "Standortzusatz; Adresse und Impressum",
            "nullable": true
          },
          "street": {
            "type": "string",
            "description": "Straße; Adresse, Impressum, VCard"
          },
          "zip": {
            "type": "string",
            "description": "Postleitzahl; Adresse, Impressum, VCard"
          },
          "city": {
            "type": "string",
            "description": "Ort; Adresse, Impressum, VCard"
          },
          "termin_url": {
            "type": "string",
            "description": "Termin-URL des Standorts"
          },
          "map_url": {
            "type": "string",
            "description": "Google-Maps-Embed; Consent-Blocker in Kontakt/Anfahrt und 10_blanc"
          },
          "map_link": {
            "type": "string",
            "description": "Kartenlink für Anfahrtslinks"
          },
          "phone1_text": {
            "type": "string",
            "description": "Telefonanzeige; Adresse, Impressum und VCard"
          },
          "phone1": {
            "type": "string",
            "description": "Telefonziel; Adresse, Impressum und VCard"
          },
          "fax1_text": {
            "type": [
              "string",
              "null"
            ],
            "description": "Fax; Adresse und Impressum"
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "E-Mail; Adresse, Impressum und VCard"
          }
        }
      }
    }
  },
  "required": [
    "pagebuilder",
    "site_base_url",
    "subscription_id",
    "title",
    "name",
    "desc",
    "fachrichtung",
    "logoalt",
    "datenschutzbeauftragter",
    "bildnachweise",
    "tools",
    "standorte"
  ]
}
