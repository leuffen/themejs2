{
    "name": "@leuffen/themejs2",
    "version": "1.0.0",
    "description": "",
    "license": "proprietary",
    "main": "./index.js",
    "module": "./index.js",
    "directories": {
        "doc": "docs",
        "themes": "themes"
    },
    "--workspaces": [
        "workspaces/nextrap-monorepo/nextrap-elements/*",
        "workspaces/nextrap-monorepo/nextrap-layout/*",
        "workspaces/nextrap-monorepo/nextrap-base/*",
        "workspaces/nextrap-monorepo/nextrap-styles/*",
        "workspaces/trunkjs-monorepo/packages/*",
        "workspaces/leuffen-monorepo/packages/*",
        "workspaces/*"
    ],
    "files": [
        "/dist",
        "/src",
        "/templates",
        "/themes",
        "/docs",
        "/font",
        "/elements",
        "/sections",
        "/_tpl",
        "*.scss",
        "*.json",
        "*.js",
        "*.md"
    ],
    "author": "",
    "dependencies": {
        "@leuffen/themejs2": "^1.0.0",
        "@leuffen/vite-jekyll-hmr-manager": "^1.0.0"
    },
    "devDependencies": {
        "puppeteer-core": "^25.3.0",
        "@types/jsdom": "^21.1.7",
        "concurrently": "^8.2.0",
        "fs-extra": "^11.1.1",
        "jsdom": "^26.0.0",
        "rollup-plugin-visualizer": "^6.0.5",
        "sass": "^1.89.2",
        "typescript": "^5.9.2",
        "vite": "^7.3.2",
        "vite-plugin-css-injected-by-js": "^4.0.1",
        "vite-plugin-static-copy": "^4.1.0",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.5"
    },
    "scripts": {
        "vite-prox": "vite dev",
        "vite-build": "vite build --watch",
        "jekyll-prox": "JEKYLL_ENV=development jekyll serve -s docs -d /var/www/html --drafts --incremental --port 4999 --host 0.0.0.0",
        "jekyll-build": "JEKYLL_ENV=production jekyll serve -s docs -d /var/www/html --drafts --livereload --port 4000 --livereload-port 4100 --host 0.0.0.0",
        "dev": "concurrently 'npm run vite-prox' 'npm run jekyll-prox'",
        "dev-b": "concurrently 'npm run vite-build' 'npm run jekyll-build'",
        "build": "vite build"
    }
}
