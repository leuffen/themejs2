  },
  "scripts": {
    "vite-prox": "vite dev",
    "vite-build": "vite build --watch",
    "jekyll-prox": "JEKYLL_ENV=development jekyll serve -s /opt/docs -d /var/www/html --drafts --port 4999 --host 0.0.0.0",
    "jekyll-build": "JEKYLL_ENV=production jekyll serve -s /opt/docs -d /var/www/html --drafts --livereload --port 4000 --livereload-port 4100 --host 0.0.0.0",
    "dev": "concurrently 'npm run vite-prox' 'npm run jekyll-prox'",
    "dev-b": "concurrently 'npm run vite-build' 'npm run jekyll-build'",
    "build": "vite build",
