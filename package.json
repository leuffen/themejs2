{
    "name": "@leuffen/themejs2",
    "version": "1.0.5",
    "description": "",
    "license": "proprietary",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/leuffen/themejs2.git"
    },
    "main": "./index.js",
    "module": "./index.js",
    "exports": {
        ".": "./index.js",
        "./functions/formmailer": "./functions/formmailer.js",
        "./*": "./*"
    },
    "directories": {
        "doc": "docs",
        "themes": "themes"
    },
    "files": [
        "/dist",
        "/src",
        "/templates",
        "/theme",
        "/_root",
        "/skills",
        "/docs",
        "/font",
        "/elements",
        "/sections",
        "/functions",
        "/_tpl",
        "*.scss",
        "*.json",
        "*.js",
        "*.md"
    ],
    "workspaces": [
        "workspaces/leuffen-monorepo/packages/*",
        "workspaces/nextrap-monorepo/nextrap-elements/*",
        "workspaces/nextrap-monorepo/nextrap-layout/*",
        "workspaces/nextrap-monorepo/nextrap-base/*",
        "workspaces/nextrap-monorepo/nextrap-styles/*",
        "workspaces/trunkjs-monorepo/packages/*"
    ],
    "author": "",
    "dependencies": {
        "@leuffen/announcements": "^1.0.1",
        "@leuffen/vite-jekyll-hmr-manager": "1.0.0",
        "@micx/lib-js": "^2.0.16",
        "@nextrap/nte-accordion": "^2.0.0",
        "@nextrap/nte-burger": "^2.0.0",
        "@nextrap/nte-card": "^2.0.1",
        "@nextrap/nte-consent-blocker": "^2.0.1",
        "@nextrap/nte-demo-viewer": "^2.0.0",
        "@nextrap/nte-dialog-component": "^2.0.0",
        "@nextrap/nte-feedback": "^2.0.0",
        "@nextrap/nte-image": "^2.0.0",
        "@nextrap/nte-input": "^2.0.1",
        "@nextrap/nte-nav": "^2.0.1",
        "@nextrap/nte-navbar": "^2.0.3",
        "@nextrap/nte-offcanvas": "^2.0.0",
        "@nextrap/nte-parallax-bg": "^2.0.0",
        "@nextrap/nte-slider": "^2.0.0",
        "@nextrap/ntl-2col": "^2.0.0",
        "@nextrap/ntl-card-grid": "^2.0.0",
        "@nextrap/ntl-card-row": "^2.0.0",
        "@nextrap/ntl-footer": "^2.0.0",
        "@nextrap/ntl-hero": "^2.0.0",
        "@nextrap/style-base": "^2.0.0",
        "@nextrap/style-button": "^2.0.0",
        "@nextrap/style-reset": "^2.0.0",
        "@nextrap/style-typography": "^2.0.0",
        "@nextrap/style-utils": "^2.0.0",
        "@trunkjs/browser-utils": "^1.0.55",
        "@trunkjs/content-pane": "^1.1.0",
        "@trunkjs/element-relocator": "^1.0.1",
        "@trunkjs/form": "^1.0.0",
        "@trunkjs/loader": "^1.0.5",
        "@trunkjs/responsive": "^1.0.0",
        "lit": "^3.3.3",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@nx/vite": "^22.7.10",
        "@types/jsdom": "^21.1.7",
        "concurrently": "^8.2.0",
        "fs-extra": "^11.1.1",
        "jsdom": "^26.0.0",
        "puppeteer-core": "^25.3.0",
        "rollup-plugin-visualizer": "^6.0.5",
        "sass": "^1.89.2",
        "typescript": "^5.9.2",
        "vite": "^7.3.2",
        "vite-plugin-css-injected-by-js": "^4.0.1",
        "vite-plugin-static-copy": "^4.1.0",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^4.1.5"
    },
    "scripts": {
        "vite-prox": "vite dev",
        "vite-build": "vite build --watch",
        "jekyll-prox": "JEKYLL_ENV=development jekyll serve -s docs -d /var/www/html --drafts  --port 4999 --host 0.0.0.0",
        "jekyll-build": "JEKYLL_ENV=production jekyll serve -s docs -d /var/www/html --drafts --livereload --port 4000 --livereload-port 4100 --host 0.0.0.0",
        "dev": "concurrently 'npm run vite-prox' 'npm run jekyll-prox'",
        "dev-b": "concurrently 'npm run vite-build' 'npm run jekyll-build'",
        "build": "vite build",
        "build:site": "vite build",
        "build:lib": "vite build --config vite.config.lib.ts"
    }
}
